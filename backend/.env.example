# Backend environment variables — copy this to .env and fill in your values
PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eternal-beads?retryWrites=true&w=majority

CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>

ADMIN_SECRET_KEY=change_me_to_a_strong_secret_key_here

PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
PAYSTACK_CALLBACK_URL=https://yourdomain.com/payment/paystack/callback
PAYSTACK_WEBHOOK_URL=https://yourdomain.com/api/payment/paystack/webhook

PAYPAL_CLIENT_ID=AxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxY
PAYPAL_CLIENT_SECRET=ExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxY
PAYPAL_MODE=sandbox
PAYPAL_RETURN_URL=https://yourdomain.com/payment/paypal/success
PAYPAL_CANCEL_URL=https://yourdomain.com/payment/paypal/cancel

FRONTEND_URL=http://localhost:5173
